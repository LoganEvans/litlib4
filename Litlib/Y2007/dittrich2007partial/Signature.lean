Litlib.paper "dittrich2007partial"
  type "article"
  title "Partial and complete observables for Hamiltonian constrained systems"
  authors ["Dittrich, B."]
  journal "General Relativity and Gravitation"
  volume "39"
  issue "11"
  pages "1891--1927"
  year "2007"
  publisher "Springer"
